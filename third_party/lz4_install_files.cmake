execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${SRC_DIR}/lib/lz4.h ${DEST_DIR}/include/lz4.h )
execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${SRC_DIR}/lib/lz4file.h ${DEST_DIR}/include/lz4file.h )
execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${SRC_DIR}/lib/lz4frame.h ${DEST_DIR}/include/lz4frame.h )
execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${SRC_DIR}/lib/lz4hc.h ${DEST_DIR}/include/lz4hc.h )

if(WIN32)
	if(${BUILD_TYPE} STREQUAL Debug)
		execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${BUILD_DIR}/x64_Debug/liblz4.lib ${DEST_DIR}/lib/liblz4.lib )
		execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${BUILD_DIR}/x64_Debug/liblz4.dll ${DEST_DIR}/bin/liblz4.dll )
	else()
		execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${BUILD_DIR}/x64_Release/liblz4.lib ${DEST_DIR}/lib/liblz4.lib )
		execute_process( COMMAND ${CMAKE_COMMAND} -E copy_if_different ${BUILD_DIR}/x64_Release/liblz4.dll ${DEST_DIR}/bin/liblz4.dll )
	endif()
else()
	message(FATAL_ERROR "Install LZ4 manually! ")
endif()
